\newcommand{\decMediationSimple}
[0]{(Unconfounded Mediation,
from Ref.\cite{pearl-2019review})

If $OP=$
$\xymatrix{
&\rvm\ar[rd]
\\
\rvd\ar[rr]\ar[ru]
&&\rvy}$
then

\beq
P(y|\cald\rvd=d, \cali_\rvm\rvd=d')=
\sum_m
P(y|d, m)
P(m|d')
\eeq

\beq
\xymatrix{
\cali\rvd=d'\ar[rd]
\\
\cald\rvd=d\ar[r]
&y
}
\xymatrix{\\=}
\xymatrix{
d'\ar[r]
&\sum m\ar[rd]
\\
d\ar[rr]
&&y}
\eeq
}

\newcommand{\decMediationPlus}
[0]{(Mediation
with universal prior $\rvxi$
and universal confounder $\rvu$,
from Ref.\cite{pearl-2019review})

If $OP=$
$\xymatrix{
&*++[F-o]{\rvu}\ar[dl]
\ar[ddr]\ar[ddl]\ar[d]
\\
\rvxi\ar[rrd]\ar[d]\ar[r]
&\rvm\ar[rd]
\\
\rvd\ar[rr]\ar[ru]
&&\rvy}$
then

\beq
P(y|\cald\rvd=d, \cali_\rvm\rvd=d')=
\sum_\xi
\sum_m
P(y|d, m, \xi)
P(m|d', \xi)P(\xi)
\eeq

\beq
\xymatrix{
\cali\rvd=d'\ar[rd]
\\
\cald\rvd=d\ar[r]
&y
}
\xymatrix{\\=}
\xymatrix{
d'\ar@/_1pc/[rr]
&\EE\xi\ar[rrd]\ar[r]
&\sum m\ar[rd]
\\
d\ar[rrr]
&&&y}
\eeq
}

